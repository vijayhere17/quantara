APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Quantara Web3 / BNB Smart Chain Testnet (BEP-20)
#
# Default: BSC Testnet (chainId 97) for client testing.
# After deploy, addresses are synced from smart-contracts/deployed-addresses.json
# via: cd smart-contracts && npm run sync:laravel:bsc-testnet
#
BLOCKCHAIN_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BLOCKCHAIN_CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
#
# Local Hardhat (dev only):
# BLOCKCHAIN_RPC=http://127.0.0.1:8545
# BLOCKCHAIN_CHAIN_ID=31337
#
# BSC Mainnet (production):
# BLOCKCHAIN_RPC=https://bsc-dataseed.binance.org/
# BLOCKCHAIN_CHAIN_ID=56
# BSC_RPC_URL=https://bsc-dataseed.binance.org/
# CHAIN_ID=56
#
# Payment token (any BEP-20). TOKEN_ADDRESS is an alias for TOKEN_CONTRACT.
# Leave empty until you deploy — then paste from deployed-addresses.json.
# TOKEN_ADDRESS=
TOKEN_CONTRACT=
CORE_CONTRACT=
TREASURY_CONTRACT=
REWARD_CONTRACT=
# Optional — improves income indexer log filters (from deployed-addresses.json):
INCOME_CONTRACT=
CONTRIBUTION_CONTRACT=
BOOSTER_CONTRACT=
RANK_CONTRACT=
COMMUNITY_CONTRACT=

# IMPORTANT:
# CORE_CONTRACT must be BTCPlanCore — NOT IncomeManager.
# Full client steps: docs/BSC_TESTNET_SETUP.md

# Optional: expose APP_URL to Vite builds (subdirectory installs).
# Prefer Laravel boot baseUrl / #basePath; this is a fallback only.
# Example local: VITE_APP_URL=http://localhost/btc
VITE_APP_URL="${APP_URL}"
