# Copy to .env.local for BSC Testnet QA (never commit real keys)

# Browser uses Vite proxy → avoids CORS "Failed to fetch"
VITE_RPC_URL=/rpc
VITE_RPC_PROXY_TARGET=https://data-seed-prebsc-1-s1.binance.org:8545/
VITE_CHAIN_ID=97

# Testnet deployer private key (root wallet). Testnet QA only — never mainnet.
VITE_DEPLOYER_PK=

# Local Hardhat (omit .env.local or use):
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_CHAIN_ID=31337
