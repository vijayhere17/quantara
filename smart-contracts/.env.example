# ── Quantara Hardhat / BSC deployment ───────────────────────────────────────
# Copy to .env and fill values. Never commit real private keys.
#
# Default target for client testing: BSC Testnet (chainId 97).

# Deployer key (REQUIRED for bscTestnet / bsc). Never commit this file with a real key.
# Format: 0x + 64 hex characters (MetaMask → Account details → Show private key)
# Example shape only — replace with your REAL testnet key (not an address):
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=

# Optional: expected chain id check during deploy (97 | 56 | 31337)
CHAIN_ID=97

# BSC Testnet RPC (publicnode is more reliable than binance seed for getLogs)
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# BSC Mainnet RPC (only when deploying to production)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Local Hardhat JSON-RPC (dev only)
BLOCKCHAIN_RPC=http://127.0.0.1:8545

# ── Token (BEP-20 payment token) ────────────────────────────────────────────
# BSC Testnet QA: leave TOKEN_ADDRESS empty → deploy MockBTCB automatically
#   (DEPLOY_MOCKS defaults to on for chainId 97).
# Production / real testnet asset: set TOKEN_ADDRESS and DEPLOY_MOCKS=0
TOKEN_ADDRESS=
# DEPLOY_MOCKS=0

# Price feed:
# - BSC Testnet: defaults to Chainlink BTC/USD 0x5741306c21795FdCBb9b265Ea0255F499DFe515C
# - BSC Mainnet: set CHAINLINK_BTC_USD or PRICE_FEED_ADDRESS (required)
# - Localhost: MockBTCPriceFeed when TOKEN_ADDRESS empty
#
# Known Chainlink BTC/USD aggregators:
#   BSC Testnet:  0x5741306c21795FdCBb9b265Ea0255F499DFe515C
#   BSC Mainnet:  0x264990fbd0A4796A3BE9d60A1AC48F2399DF4EBd
CHAINLINK_BTC_USD=0x5741306c21795FdCBb9b265Ea0255F499DFe515C
PRICE_FEED_ADDRESS=

# Optional: recorded in deployed-addresses.json
TREASURY_WALLET=
